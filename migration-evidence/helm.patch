+func TestStatusObserverWaitForDeleteDefersUnknownUntilInitialSync(t *testing.T) {
+	t.Parallel()
+	id := object.ObjMetadata{
+		Namespace: "ns",
+		Name:      "pod",
+		GroupKind: schema.GroupKind{Kind: "Pod"},
+}
+	statusCollector := collector.NewResourceStatusCollector([]object.ObjMetadata{id})
+	var cancelled atomic.Bool
+	observer := statusObserver(func() { cancelled.Store(true) }, status.NotFoundStatus, slog.Default())
+
+	observer(statusCollector, event.Event{Type: event.ResourceUpdateEvent})
+	assert.False(t, cancelled.Load(), "transient Unknown status must not complete delete wait before initial sync")
+
+	observer(statusCollector, event.Event{Type: event.SyncEvent})
+	assert.True(t, cancelled.Load(), "Unknown status after initial sync means the resource is already absent")
+}
